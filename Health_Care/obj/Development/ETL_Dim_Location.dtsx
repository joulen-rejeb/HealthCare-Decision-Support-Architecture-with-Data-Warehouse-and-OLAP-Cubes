                          name="FriendlyExpression">(DT_WSTR,100)admission_location == "EMERGENCY ROOM ADMIT" ? "Emergency" : (admission_location == "CLINIC REFERRAL/PREMATURE") ? "Outpatient" : (admission_location == "TRANSFER FROM HOSP/EXTRAM") ? "Transfer" : (discharge_location == "HOME HEALTH CARE") ? "Post-Acute" : (discharge_location == "SNF") ? "Post-Acute" : (discharge_location == "REHAB/DISTINCT PART HOSP") ? "Post-Acute" : "Other"</property>
