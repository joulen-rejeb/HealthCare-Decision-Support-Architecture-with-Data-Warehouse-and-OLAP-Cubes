                          containsID="true"
                          dataType="System.String"
                          description="Expression de colonne dérivée"
                          name="Expression">(DT_WSTR,100)#{Package\Alim_Dim_Location\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[admission_location]} == "EMERGENCY ROOM ADMIT" ? "Emergency" : (#{Package\Alim_Dim_Location\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[admission_location]} == "CLINIC REFERRAL/PREMATURE") ? "Outpatient" : (#{Package\Alim_Dim_Location\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[admission_location]} == "TRANSFER FROM HOSP/EXTRAM") ? "Transfer" : (#{Package\Alim_Dim_Location\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[discharge_location]} == "HOME HEALTH CARE") ? "Post-Acute" : (#{Package\Alim_Dim_Location\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[discharge_location]} == "SNF") ? "Post-Acute" : (#{Package\Alim_Dim_Location\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[discharge_location]} == "REHAB/DISTINCT PART HOSP") ? "Post-Acute" : "Other"</property>
